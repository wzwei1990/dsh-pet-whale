{
  "name": "pet-whale",
  "version": "1.2.7",
  "description": "桌宠小鲸鱼：DeepSeek Harness 桌宠插件，桌面端和网页端都能用，随 agent 状态切换动画（官方轮廓版）",
  "homepage": "https://nzl153.github.io/dsh-pet-whale/preview.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nzl153/dsh-pet-whale.git"
  },
  "bugs": {
    "url": "https://github.com/nzl153/dsh-pet-whale/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "whale",
    "pet"
  ],
  "license": "MIT",
  "publishConfig": { "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.5-alpha.2 <0.3.0",
      "dshReleases": {
        "0.1.5-alpha.2": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.5-rc.3": "compatible",
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "dev": "tsdown --config ./tsdown.config.ts --watch",
    "dev:client": "tsdown --config ./tsdown.config.ts --watch",
    "build": "tsdown --config ./tsdown.config.ts && node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:built",
    "test:built": "node tests/smoke.mjs && node --test tests/regression.mjs tests/hmr.mjs tests/host-snapshot.mjs tests/build.mjs",
    "verify": "npm run typecheck && npm test && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run verify",
    "verify:hmr": "node scripts/verify-hmr.mjs",
    "pet:doctor": "node scripts/doctor.mjs",
    "preview": "node scripts/preview-pets.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "jsdom": "^30.0.1",
    "tsdown": "0.22.2",
    "typescript": "^5.6.0"
  }
}
